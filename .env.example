# Local development. Production must use AUTH_MODE=local, oidc, or hybrid with HTTPS.
MMT_DATABASE_URL=postgresql://mmt@127.0.0.1:55483/mmt
MMT_TEST_DATABASE_URL=postgresql://mmt@127.0.0.1:55483/mmt_test
HOST=127.0.0.1
PORT=4182
# local | oidc | hybrid | development. oidc and hybrid require OIDC_ISSUER_URL, OIDC_CLIENT_ID and OIDC_ALLOWED_GROUPS.
AUTH_MODE=development
# Sessions end after the idle or the absolute limit, whichever comes first (seconds).
AUTH_SESSION_IDLE_SECONDS=28800
AUTH_SESSION_ABSOLUTE_SECONDS=43200
# Upper bound of a new API token's lifetime (1-3650 days); a token issued without an expiry ends after this.
MMT_TOKEN_MAX_LIFETIME_DAYS=365
MMT_PUBLIC_URL=http://127.0.0.1:5182
MMT_WEB_ORIGIN=http://127.0.0.1:5182
MMT_ALLOW_PRIVATE_ORIGINS=true
DEVELOPMENT_ADMIN_EMAIL=admin@localhost
MMT_ALLOW_SEED=false
MMT_ALLOW_LOCAL_EXECUTOR=false
ARTIFACT_FILESYSTEM_ROOT=./var/artifacts
# Per-artifact size limit (default 200 GiB). Upload request timeout 0 disables it; the idle timeout is in ms.
MMT_ARTIFACT_MAX_BYTES=214748364800
MMT_UPLOAD_REQUEST_TIMEOUT_MS=0
MMT_UPLOAD_IDLE_TIMEOUT_MS=120000
# Days a deleted Artifact's blob is kept before the garbage collector removes it.
MMT_ARTIFACT_DELETE_GRACE_DAYS=7
# MLflow multipart upload through server-info and mpu/*; downloads stay false (no presigned URLs).
MMT_MLFLOW_MULTIPART_UPLOADS=true
MMT_MLFLOW_MULTIPART_DOWNLOADS=false
# How long MLflow's mpu/complete waits for verification before 503 (below the SDK's 120 s timeout).
MMT_UPLOAD_FINALIZE_WAIT_MS=100000
# Encrypts storage backend secrets in the DB: base64 of 32 bytes (generate with `openssl rand -base64 32`).
# Without it, S3 storage backends with a secret cannot be created from /admin.
MMT_STORAGE_SECRET_KEY=
# Rows of one search CSV export (decisions.md: 50000); the rest is cut and marked as truncated.
MMT_CSV_EXPORT_MAX_ROWS=50000
# Checkpoints listed per Run by default; older ones are only hidden (retained=false), their Artifacts stay.
MMT_CHECKPOINT_KEEP_COUNT=5

# Authentik OIDC provider. Exact callback: {MMT_PUBLIC_URL}/api/auth/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Label of the SSO button on the login screen.
OIDC_LABEL=Authentik
OIDC_SCOPES=openid profile email
# Link an SSO login to a same-email local user only when true. Privileged local users are never linked.
OIDC_AUTO_LINK_VERIFIED_EMAIL=false
# Required for oidc and hybrid: users outside these groups cannot log in.
OIDC_ALLOWED_GROUPS=mmt-users,mmt-admins
# Group -> global role (admin | user). The strongest role wins; unmapped users get OIDC_DEFAULT_ROLE.
OIDC_ROLE_MAPPING_JSON={"mmt-admins":"admin","mmt-users":"user"}
OIDC_DEFAULT_ROLE=user
# Shorthand for {"<group>":"admin"}. If set with OIDC_ROLE_MAPPING_JSON, the admin groups must match.
OIDC_ADMIN_GROUP=
OIDC_ALLOW_INSECURE_HTTP=false
# Required for oidc and hybrid: base64 of 32 bytes (openssl rand -base64 32), different from
# MMT_STORAGE_SECRET_KEY. Encrypts the IdP tokens kept in SSO sessions for the group recheck.
MMT_SESSION_ENCRYPTION_KEY=
# Seconds between UserInfo checks of an SSO session. Add offline_access to OIDC_SCOPES for refresh tokens.
OIDC_RECHECK_SECONDS=60
# API tokens of SSO users stop (401 identity_sync_required) when the last group sync is older than this.
OIDC_TOKEN_SYNC_MAX_AGE_SECONDS=604800

# S3 appears as a selectable backend when S3_BUCKET is configured.
# Credentials may instead come from the AWS SDK's default provider chain.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PREFIX=mado-model-tracking
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notification channels name these variables (prefix MMT_NOTIFICATION_ is required); the values
# never go into the DB. Example names: set them to the Slack incoming webhook URL, the webhook URL
# and the webhook signing secret, then register the names under Settings > 通知.
MMT_NOTIFICATION_SLACK_URL=
MMT_NOTIFICATION_WEBHOOK_URL=
MMT_NOTIFICATION_WEBHOOK_SECRET=
# Email channels are sent only when both are set. smtp:// uses STARTTLS when offered, smtps://
# connects with TLS; the URL may carry user:password. Example: Mado Model Tracking <mmt@example.com>
MMT_SMTP_URL=
MMT_SMTP_FROM=

# Must match the separate Mado plugin service's MMT_PLUGIN_TOKEN.
MMT_MADO_PLUGIN_TOKEN=
# Optional SSH credentials for the API's read-only repository preview.
# Both paths are on the API server; Git execution on Compute uses its own credentials.
MMT_GIT_SSH_KEY_PATH=
MMT_GIT_KNOWN_HOSTS_PATH=
