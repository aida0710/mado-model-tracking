# Environment file for one worker (mado-tracking-worker@<worker-id>.service).
# `mado-tracking-worker install` writes this file for you. When writing it by hand:
#   install -m 600 /dev/null /etc/mado-tracking-worker/<worker-id>.env   (user unit: ~/.config/mado-tracking-worker/)
# Plain KEY=value lines only: no quotes, no $, no backslashes.

# API origin or .../api. Compute targets must reach this URL too (127.0.0.1 is the worker host only).
MMT_API_URL=https://tracking.example.internal
# Stable across restarts and upgrades; the systemd instance name uses the same value.
MMT_WORKER_ID=gpu-host-1
# Comma separated compute target IDs. Empty = every target the token and API allow.
MMT_WORKER_TARGET_IDS=
# Journal of running Jobs. Keep it across reinstalls; deleting it abandons running Jobs.
MMT_WORKER_STATE_DIR=/var/lib/mado-tracking-worker/gpu-host-1
# Service token with read, worker:execute, artifacts:write. Paste it with an editor, not on a command line.
MMT_API_TOKEN=
