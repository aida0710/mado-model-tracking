# Preview worker: the API code plus ffmpeg/ffprobe. Kept apart from Dockerfile.api so the API image
# carries no media decoders; see apps/api/src/previewWorker.ts.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api ./apps/api
COPY apps/web/package.json ./apps/web/package.json
COPY packages ./packages
RUN npm ci && mkdir -p /app/var/artifacts /app/var/preview-work && chown -R node:node /app/var
ENV NODE_ENV=production MMT_PREVIEW_WORK_DIR=/app/var/preview-work
USER node
CMD ["npm", "run", "preview-worker", "--workspace", "@mmt/api"]
